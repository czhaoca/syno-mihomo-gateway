# Keep the runtime image minimal: no tests, caches, or dev-only files
# (nested __pycache__ dirs included - the bare pattern only matches root).
tests/
**/__pycache__/
*.pyc
**/*.pyc
.ruff_cache/
.pytest_cache/
Dockerfile
.dockerignore
ruff.toml
requirements-dev.txt

# Frontend (#78): the builder stage runs `npm ci` itself and produces dist,
# so neither belongs in the build context. Excluding node_modules also keeps
# a ~200MB tree out of every layer and out of the runtime image, where
# `COPY . ./app` would otherwise pick it up.
ui/node_modules/
ui/dist/
