{
  "components": {
    "schemas": {
      "DeviceCreate": {
        "properties": {
          "address": {
            "description": "IPv4 address or CIDR (bare IP = /32)",
            "title": "Address",
            "type": "string"
          },
          "mode": {
            "enum": [
              "full-direct",
              "full-tunnel"
            ],
            "title": "Mode",
            "type": "string"
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          }
        },
        "required": [
          "address",
          "mode"
        ],
        "title": "DeviceCreate",
        "type": "object"
      },
      "DeviceUpdate": {
        "properties": {
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "mode": {
            "anyOf": [
              {
                "enum": [
                  "full-direct",
                  "full-tunnel"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "title": "DeviceUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IdentityImport": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/IdentityImportEntry"
            },
            "title": "Entries",
            "type": "array"
          },
          "override": {
            "default": false,
            "description": "Adopt hosts whose alias was typed by an operator. Attended use only - a scheduled sync leaves this off",
            "title": "Override",
            "type": "boolean"
          }
        },
        "title": "IdentityImport",
        "type": "object"
      },
      "IdentityImportEntry": {
        "properties": {
          "alias": {
            "description": "Human name; blank is refused on import",
            "title": "Alias",
            "type": "string"
          },
          "ip": {
            "description": "IPv4 host address (a range is refused)",
            "title": "Ip",
            "type": "string"
          },
          "source": {
            "description": "Where this alias came from, e.g. unifi or nimbus. 'hand-edit' is reserved for an operator's own edit",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "ip",
          "alias",
          "source"
        ],
        "title": "IdentityImportEntry",
        "type": "object"
      },
      "IdentityUpdate": {
        "properties": {
          "alias": {
            "default": "",
            "description": "Human name for this host; blank removes the alias",
            "title": "Alias",
            "type": "string"
          }
        },
        "title": "IdentityUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Dynamic device policy for the Syno Mihomo Gateway. The /v1 surface is additive-only: fields and endpoints may be added, but a breaking change (removal, rename, semantics change) requires a NEW version prefix and explicit owner acknowledgment. Reads are LAN-open; every mutation requires the PANEL_SECRET bearer token.",
    "title": "Syno Mihomo Gateway Panel",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
